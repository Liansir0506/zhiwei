# ===== 应用 =====
APP_NAME=telecom-ops-rag
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8010
SCENARIO=telecom_ops

# ===== 模拟企业系统 Adapter（技术验证用途，非真实客户接口）=====
ENTERPRISE_BASE_URL=http://enterprise-mock:8020/mock/v1
MOCK_ENTERPRISE_HOST_PORT=8020
ADAPTER_TIMEOUT_SECONDS=2
ADAPTER_MAX_RETRIES=2
ADAPTER_PAGE_SIZE=100

# ===== 存储（容器内用服务名；本机调试改 127.0.0.1）=====
MYSQL_DSN=mysql+pymysql://rag:rag_pass@mysql:3306/rag_kb?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
MILVUS_URI=http://milvus:19530
DOC_COLLECTION=doc_collection
FAQ_COLLECTION=faq_collection
DATA_DIR=/app/data
REPORTS_DIR=/app/reports

# ===== 模型（volume 挂载，不在构建期下载）=====
MODELS_DIR=/app/models
EMBEDDING_MODEL_PATH=/app/models/bge-m3
RERANKER_MODEL_PATH=/app/models/bge-reranker-large
INTENT_MODEL_PATH=/app/models/bert_intent_classifier_v1
# 6GB 显存机器建议 cpu；有富余可改 cuda。注释单独成行以兼容 docker --env-file。
EMBEDDING_DEVICE=cpu
RERANK_DEVICE=cpu

# ===== LLM（OpenAI 兼容，必填于阶段7前）=====
LLM_API_KEY=sk-xxxx           # 阶段7前替换
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
GENERATION_ENABLED=true     # false：同步/SSE/WebSocket 仅输出证据，不调用 LLM

# ===== 检索默认参数 =====
DENSE_EF=64
TOP_K_DENSE=50
TOP_K_SPARSE=50
TOP_N_FINAL=5
RERANK_MIN=0.30
FAQ_DIRECT=0.80
FAQ_GAP=0.05

# ===== 缓存 TTL（秒）=====
CACHE_EMB_TTL=86400
CACHE_RET_TTL=600
CACHE_FAQ_TTL=3600

# 生产环境置 true，启用 API Key 认证
AUTH_REQUIRED=false
INGEST_WORKER_CONCURRENCY=1
# 宿主机挂载目录（Docker Compose；Windows 可填写 F:/path 形式）
APP_DATA_DIR=./data
APP_REPORTS_DIR=./reports
APP_MODELS_DIR=./models
APP_SCENARIOS_DIR=./scenarios
INGEST_OMP_THREADS=4
WORKFLOW_EVIDENCE_ENABLED=false
