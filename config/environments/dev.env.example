# 开发环境：保持现有端口和集合名，兼容当前本地使用方式。
APP_ENV=dev
APP_ENV_FILE=.env.dev
COMPOSE_PROJECT_NAME=telecom-ops-rag-dev
MYSQL_DATABASE=rag_kb
MYSQL_HOST_PORT=3306
REDIS_DB=0
REDIS_HOST_PORT=6379
MILVUS_HOST_PORT=19530
MILVUS_HEALTH_HOST_PORT=9091
API_HOST_PORT=8010
MOCK_ENTERPRISE_HOST_PORT=8020
ENTERPRISE_BASE_URL=http://127.0.0.1:8020/mock/v1
DOC_COLLECTION=doc_collection
FAQ_COLLECTION=faq_collection
APP_DATA_DIR=./data
APP_REPORTS_DIR=./reports
MYSQL_DSN=mysql+pymysql://rag:rag_pass@127.0.0.1:3306/rag_kb?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
MILVUS_URI=http://127.0.0.1:19530
DATA_DIR=./data
REPORTS_DIR=./reports
MODELS_DIR=./models
EMBEDDING_MODEL_PATH=./models/bge-m3
RERANKER_MODEL_PATH=./models/bge-reranker-large
INTENT_MODEL_PATH=./models/bert_intent_classifier_v1
