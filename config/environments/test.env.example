# 测试环境：独立 Compose project、端口、数据库、Redis DB、Milvus 集合和文件目录。
APP_ENV=test
APP_ENV_FILE=.env.test
COMPOSE_PROJECT_NAME=telecom-ops-rag-test
MYSQL_DATABASE=rag_kb_test
MYSQL_HOST_PORT=13306
REDIS_DB=15
REDIS_HOST_PORT=16379
MILVUS_HOST_PORT=29530
MILVUS_HEALTH_HOST_PORT=19091
API_HOST_PORT=18010
MOCK_ENTERPRISE_HOST_PORT=18020
ENTERPRISE_BASE_URL=http://127.0.0.1:18020/mock/v1
DOC_COLLECTION=test_doc_collection
FAQ_COLLECTION=test_faq_collection
APP_DATA_DIR=./.runtime/test/data
APP_REPORTS_DIR=./.runtime/test/reports
MYSQL_DSN=mysql+pymysql://rag:REPLACE_DATABASE_PASSWORD@127.0.0.1:13306/rag_kb_test?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:16379/15
MILVUS_URI=http://127.0.0.1:29530
DATA_DIR=./.runtime/test/data
REPORTS_DIR=./.runtime/test/reports
MODELS_DIR=./models
EMBEDDING_MODEL_PATH=./models/bge-m3
RERANKER_MODEL_PATH=./models/bge-reranker-large
INTENT_MODEL_PATH=./models/bert_intent_classifier_v1

# Private values are generated by scripts/init_local_env.py, never commit the generated file.
MYSQL_USER=rag
MYSQL_PASSWORD=REPLACE_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_ROOT_PASSWORD
MINIO_ACCESS_KEY=REPLACE_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_MINIO_SECRET_KEY
AUTH_REQUIRED=true
GENERATION_ENABLED=false
AGENT_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
