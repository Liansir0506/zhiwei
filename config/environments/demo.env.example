# 面试演示环境：与开发、测试环境使用独立数据卷和宿主机端口。
APP_ENV=demo
APP_ENV_FILE=.env.demo
COMPOSE_PROJECT_NAME=telecom-ops-rag-demo
MYSQL_DATABASE=rag_kb_demo
MYSQL_HOST_PORT=23306
REDIS_DB=1
REDIS_HOST_PORT=26379
MILVUS_HOST_PORT=39530
MILVUS_HEALTH_HOST_PORT=29091
API_HOST_PORT=28010
MOCK_ENTERPRISE_HOST_PORT=28020
ENTERPRISE_BASE_URL=http://127.0.0.1:28020/mock/v1
DOC_COLLECTION=demo_doc_collection
FAQ_COLLECTION=demo_faq_collection
APP_DATA_DIR=./.runtime/demo/data
APP_REPORTS_DIR=./.runtime/demo/reports
MYSQL_DSN=mysql+pymysql://rag:rag_pass@127.0.0.1:23306/rag_kb_demo?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:26379/1
MILVUS_URI=http://127.0.0.1:39530
DATA_DIR=./.runtime/demo/data
REPORTS_DIR=./.runtime/demo/reports
MODELS_DIR=./models
EMBEDDING_MODEL_PATH=./models/bge-m3
RERANKER_MODEL_PATH=./models/bge-reranker-large
INTENT_MODEL_PATH=./models/bert_intent_classifier_v1
